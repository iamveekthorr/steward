# ── Cloudflare Pages production environment ──────────────────────────────────
# Copy this to .env.production and fill in real values BEFORE running
# `pnpm build:cf`.  Never commit the filled-in file.
#
# Or set these as Environment Variables in the Cloudflare Pages dashboard
# (Settings → Environment variables) for the `production` deployment context.
# NEXT_PUBLIC_* vars must be set so they are available at build time.

# Full URL to the production API — include the /api/v1 prefix
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
