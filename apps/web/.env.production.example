# ── Cloudflare Pages production environment ──────────────────────────────────
# Set ALL of these in Cloudflare Pages dashboard:
#   Pages → steward-web → Settings → Environment variables → Production
#
# NEXT_PUBLIC_* vars are baked in at build time (CI reads them during next build).
# All others are runtime secrets — mark them as "Encrypted" in the dashboard.
# Never commit a filled-in copy of this file.

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Full URL of the deployed frontend (no trailing slash).
# Used to build email links (verify, reset-password, invite).
NEXT_PUBLIC_APP_URL=https://steward.pages.dev

# ── API ───────────────────────────────────────────────────────────────────────
# Full URL to the production API including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
# Mark as Encrypted in Cloudflare Pages dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — domain must be verified in your Resend account.
# See: https://resend.com/docs/dashboard/domains/introduction
# Until verified, use onboarding@resend.dev (sends only to your Resend account email).
RESEND_FROM=noreply@yourdomain.com
