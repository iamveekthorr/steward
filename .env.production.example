# ── Steward API — production environment ─────────────────────────────────────
# Copy to .env on your VPS and fill in real values.  Never commit this file.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=steward
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=steward
POSTGRES_HOST=db
POSTGRES_DB_PORT=5432
DATABASE_URL=postgres://steward:<change-me>@db:5432/steward

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=3000
JWT_SECRET=<64-char-random-string>

# CORS — comma-separated list of allowed origins
# Include your Cloudflare Pages URL and any custom domain
ALLOWED_ORIGIN=https://steward.pages.dev,https://yourdomain.com

# ── Cloudflare R2 object storage ──────────────────────────────────────────────
S3_API_URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET=steward-uploads
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
