        {
          "name": "Create link (with default password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/links/create-with-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"worker_first_name\": \"Amara\",\n  \"worker_last_name\": \"Osei\",\n  \"worker_email\": \"amara@example.com\",\n  \"job_type\": \"domestic\",\n  \"start_date\": \"2026-01-01\",\n  \"home_country\": \"Ghana\",\n  \"work_country\": \"United Kingdom\",\n  \"home_city\": null,\n  \"work_city\": null\n}"
            },
            "description": "Provision a worker account with a temporary password. The link is immediately activated. Returns temporary_password \u2014 share it securely with the worker. Worker must change their password on first login (must_change_password=true)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.link_id) {",
                  "  pm.collectionVariables.set('link_id', b.data.link_id);",
                  "  console.log('Temp password:', b.data.temporary_password);",
                  "  console.log('Share this securely with the worker. They must change it on first login.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Manager \u2014 Payouts",
      "description": "Record payments to workers.",
      "item": [
