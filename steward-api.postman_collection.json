              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/payouts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"link_id\": \"{{link_id}}\",\n  \"base_amount\": 15000000,\n  \"currency\": \"NGN\",\n  \"paid_at\": \"2025-10-07T10:00:00Z\",\n  \"notes\": \"October salary\",\n  \"proof_key\": null\n}"
            },
            "description": "Record a payment for a worker link. `base_amount` is in minor units (kobo for NGN \u2014 so 150,000 NGN = 15000000). `proof_key` is the R2 object key returned by `POST /uploads/presign` after uploading a proof image. Omit if no proof."
          }
        }
      ]
