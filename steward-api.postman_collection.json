        {
          "name": "Create manager account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/admin/managers/create-account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"manager@example.com\"\n}"
            },
            "description": "Provision a new manager account with a temporary password. Returns the temporary_password \u2014 share it securely with the manager. The account has must_change_password=true: the manager must change their password on first login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.manager_id) {",
                  "  pm.collectionVariables.set('manager_id', b.data.manager_id);",
                  "  console.log('Temp password:', b.data.temporary_password);",
                  "  console.log('Share this securely with the manager. They must change it on first login.');",
                  "}"
                ]
              }
            }
          ]
