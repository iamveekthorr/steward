{
  "info": {
    "name": "Steward API",
    "description": "Complete API collection for Steward \u2014 payment management for diaspora users.\n\n**Base URL:** `http://localhost:3000/api/v1`\n\n**Auth:** Most endpoints require a Bearer token. Run the matching Login request first \u2014 the collection auto-sets `access_token` via a test script.\n\n**Test credentials:**\n- Admin: `dikehokonkwo@icloud.com` / `Steward@Admin2026!`\n- Manager: `manager@steward.test` / `Steward123!`\n- Worker: `worker@steward.test` / `Steward123!`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "manager_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "link_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "router_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Registration, login, token refresh, and logout.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Steward123!\"\n}"
            },
            "description": "Create a new user account. Returns access_token and refresh_token on success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/verify-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verification_token}}\"\n}"
            },
            "description": "Verify email address using the token returned by Register. Required before the user can log in."
          }
        },
        {
          "name": "Login (manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@steward.test\",\n  \"password\": \"Steward123!\"\n}"
            },
            "description": "Login as the test manager. Sets access_token and refresh_token collection variables automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.data.refresh_token);",
                  "  console.log('Token set:', b.data.access_token.slice(0,20) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dikehokonkwo@icloud.com\",\n  \"password\": \"Steward@Admin2026!\"\n}"
            },
            "description": "Login as the admin. Sets access_token and refresh_token. Response includes must_change_password: false for admin accounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.data.refresh_token);",
                  "  if (b.data.must_change_password) {",
                  "    console.warn('must_change_password=true \u2014 call PATCH /auth/change-password before other requests');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (worker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"worker@steward.test\",\n  \"password\": \"Steward123!\"\n}"
            },
            "description": "Login as the test worker. Sets access_token and refresh_token collection variables automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "description": "Exchange a refresh token for a new access token. Updates access_token variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/auth/logout",
            "description": "Invalidates the current access token server-side."
          }
        },
        {
          "name": "Change password (forced or voluntary)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"TEMP_PASSWORD_HERE\",\n  \"new_password\": \"MyNewSecure#2026\"\n}"
            },
            "description": "Change the authenticated user's password. Required on first login for provisioned accounts (must_change_password=true). Clears the forced-change flag on success."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Current user profile and settings. All endpoints require auth.",
      "item": [
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/users/me",
            "description": "Returns the authenticated user's profile: id, name, email, role."
          }
        },
        {
          "name": "Get all users (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Returns all users. Intended for admin use."
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/users/:id",
            "variable": [
              {
                "key": "id",
                "value": "{{manager_id}}"
              }
            ],
            "description": "Fetch a single user by UUID."
          }
        },
        {
          "name": "Get user settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/users/settings",
            "description": "Returns the user's settings: theme, email notification preferences, reminder days."
          }
        },
        {
          "name": "Update user settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/users/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"theme\": \"dark\",\n  \"enable_email_notifications\": true,\n  \"reminder_days_before\": 3\n}"
            },
            "description": "Partial update of user settings. All fields are optional."
          }
        }
      ]
    },
    {
      "name": "Manager \u2014 Dashboard",
      "description": "Dashboard data endpoints. Requires manager auth. KPIs refresh every 30s; charts every 30min.",
      "item": [
        {
          "name": "Dashboard KPIs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/dashboard/kpis",
            "description": "Fast KPI tiles (4 parallel COUNT queries). Returns: active_links, total_links, pending_links, overdue_links, due_this_week, due_this_week_amounts, paid_this_month, paid_this_month_payouts, overdue_worker."
          }
        },
        {
          "name": "Dashboard Charts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/dashboard/charts",
            "description": "Heavy chart data (8 parallel queries). Returns: monthly_trend, status_breakdown, currency_totals, needs_attention, on_time_rate, total_payouts_12mo, avg_delay_days, monthly_punctuality, paid_by_link, automation."
          }
        },
        {
          "name": "Dashboard (legacy \u2014 all data)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/dashboard",
            "description": "Legacy combined endpoint \u2014 all dashboard data in one response. Use /kpis and /charts instead."
          }
        }
      ]
    },
    {
      "name": "Manager \u2014 Links",
      "description": "Manage worker links (employment relationships). Requires manager auth.",
      "item": [
        {
          "name": "List links",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/links",
            "description": "Returns all links for the authenticated manager, including worker name, job type, pay schedule, status, and next due date."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.[0]?.id) {",
                  "  pm.collectionVariables.set('link_id', b.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/manager/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"worker_email\": \"worker@steward.test\",\n  \"job_type\": \"House Assistant\",\n  \"start_date\": \"2025-01-01T00:00:00Z\",\n  \"home_country\": \"Nigeria\",\n  \"work_country\": \"Nigeria\",\n  \"home_city\": \"Lagos\",\n  \"work_city\": \"Abuja\"\n}"
