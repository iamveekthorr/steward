      "name": "Admin",
      "description": "Admin-only operations. Require a JWT with role='admin'. Log in with the admin account to get this token.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dikehokonkwo@icloud.com\",\n  \"password\": \"Steward@Admin2026!\"\n}"
            },
            "description": "Convenience copy: log in as admin and auto-set the token before hitting admin endpoints."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', b.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', b.data.refresh_token);",
